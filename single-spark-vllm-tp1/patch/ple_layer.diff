+    # --- Kai/2Wild: disk-backed lookup path -------------------------------
+    def _ple_mmap_table(self) -> PLEMmapTable:
+        table = getattr(self, "_ple_table", None)
+        if table is None:
+            model_dir = getattr(self, "_ple_model_dir", None) or _os.environ.get(
+                "QWEN4EXP_PLE_MODEL_DIR"
+            )
+            if not model_dir:
+                raise RuntimeError(
+                    "PLE mmap: model dir unknown (set at PLE layer init or "
+                    "QWEN4EXP_PLE_MODEL_DIR)"
+                )
+            layer_idx = int(self.layer_name.rsplit("layers.", 1)[1].split(".", 1)[0])
+            table = PLEMmapTable(model_dir, layer_idx, threads=_ple_mmap_threads())
+            if self.ngram_embedding.org_vocab_size != table.rows_total:
+                raise ValueError(
+                    f"PLE mmap table rows {table.rows_total} != vocab "
+                    f"{self.ngram_embedding.org_vocab_size}"
+                )
+            self._ple_table = table
+            self._ple_row_bytes = int(table.row_bytes)
+            self._ple_dtype = table.dtype
+        return table
 
+    def _ple_mmap_lookup(self, ngram_ids: torch.Tensor) -> torch.Tensor:
+        # Traced by torch.compile: only tensor ops + constant attribute reads here.
+        # The table object is built eagerly in load_weights (thread pool + fds
+        # cannot be constructed under Dynamo tracing); the custom op body below
+        # is opaque to the tracer and does the host-side work.
+        row_bytes = self._ple_row_bytes
+        out = torch.empty(
+            (ngram_ids.numel(), row_bytes), dtype=torch.uint8, device=ngram_ids.device
+        )
+        torch.ops.vllm.qwen4_exp_ple_mmap_gather(ngram_ids, out, self.layer_name)
+        return out.view(self._ple_dtype).view(
+            ngram_ids.shape[0], self.ngram_heads * self.head_dim
+        )
+
+    def _ple_mmap_gather_into(self, ngram_ids: torch.Tensor, out: torch.Tensor) -> None:
+        table = self._ple_mmap_table()
+        rows = table.gather_cpu(ngram_ids.detach().to("cpu", dtype=torch.int64))
+        out.copy_(rows, non_blocking=True)
+
